# Copied to .env by `make up`. No secrets: nothing in this project needs one.

# Host ports. Change them if they clash with something on your machine.
PROVIDER_PORT=18103
PRICE_PORT=18104
GRAFANA_PORT=13000
OTLP_HTTP_PORT=14318
TEMPO_PORT=13200
PROMETHEUS_PORT=19090

# "full" is the service this project builds; "none" is the benchmark's "before" (no timeouts, retries, limit or cache).
PRICE_PROTECTION=full
# Provider calls allowed in flight at once; the rest are refused. Size it to what the provider can sustain.
PRICE_PROVIDER_MAX_CONCURRENT_CALLS=10
